// Função principal para carregar e exibir atalhos
function carregarAtalhos() {
  const chaveAtalhos = getChaveAtalhos();
  if (!chaveAtalhos) {
    console.warn('⚠️ Usuário não identificado - atalhos não carregados');
    return;
  }
  
  const shortcutButtonsContainer = document.querySelector('.shortcut-buttons');
  if (!shortcutButtonsContainer) {
    console.warn('⚠️ Container de atalhos não encontrado');
    return;
  }
  
  // Buscar atalhos salvos do localStorage OU do PHP
  let atalhosSalvos = [];
  
  // Primeiro tenta pegar do PHP (se existir window.atalhosPHP)
  if (typeof window.atalhosPHP !== 'undefined' && window.atalhosPHP) {
    atalhosSalvos = window.atalhosPHP;
    console.log('📥 Atalhos carregados do PHP:', atalhosSalvos);
  } else {
    // Se não, tenta localStorage
    const savedData = localStorage.getItem(chaveAtalhos);
    if (savedData) {
      try {
        atalhosSalvos = JSON.parse(savedData);
        console.log('📥 Atalhos carregados do localStorage:', atalhosSalvos);
      } catch (e) {
        console.error('❌ Erro ao parsear atalhos:', e);
        atalhosSalvos = [];
      }
    }
  }
  
  // Limpar container
  shortcutButtonsContainer.innerHTML = '';
  
  const totalSlots = 4;
  
  // Criar todos os 4 slots
  for (let i = 0; i < totalSlots; i++) {
    const atalhoId = atalhosSalvos[i];
    
    if (atalhoId && atalhosDisponiveis[atalhoId]) {
      // Atalho preenchido
      const atalho = atalhosDisponiveis[atalhoId];
      const link = document.createElement('a');
      link.href = atalho.link;
      link.className = 'shortcut-btn';
      link.innerHTML = `
        ${atalho.icone}
        <span>${atalho.nome}</span>
      `;
      
      // Adicionar evento especial para minimapa
      if (atalhoId === 'minimapa') {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const mapButton = document.getElementById('mapButton');
          if (mapButton) {
            mapButton.click();
          } else {
            // Se não encontrar o botão, abrir popup de blocos diretamente
            const popup = document.getElementById('popupBlocos');
            if (popup) popup.classList.add('show');
          }
        });
      }
      
      shortcutButtonsContainer.appendChild(link);
    } else {
      // Slot vazio - botão de adicionar
      const btn = document.createElement('button');
      btn.className = 'add-shortcut-btn';
      btn.textContent = '+';
      btn.title = 'Adicionar atalho';
      btn.onclick = () => window.location.href = 'atalhos.php';
      
      shortcutButtonsContainer.appendChild(btn);
    }
  }
  
  const atalhosExistentes = atalhosSalvos.filter(id => id && atalhosDisponiveis[id]).length;
  console.log(`✅ ${atalhosExistentes} atalhos de ${totalSlots} carregados`);
}

// Função para inicializar o sistema de atalhos
function inicializarSistemaAtalhos() {
  console.log('🚀 Inicializando sistema de atalhos...');
  
  // Tentar carregar múltiplas vezes para garantir que funcione
  carregarAtalhos();
  
  // Recarregar após um delay (caso o DOM ainda não esteja pronto)
  setTimeout(carregarAtalhos, 100);
  setTimeout(carregarAtalhos, 500);
  
  console.log('✅ Sistema de atalhos inicializado');
}

// Auto-inicializar quando o DOM estiver pronto
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', inicializarSistemaAtalhos);
} else {
  inicializarSistemaAtalhos();
}

// Exportar funções para uso global
window.carregarAtalhos = carregarAtalhos;
window.inicializarSistemaAtalhos = inicializarSistemaAtalhos;